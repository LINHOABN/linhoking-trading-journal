# PostgreSQL connection — e.g. Neon, Supabase, Railway, or local
DATABASE_URL=postgresql://linhoking:password@localhost:5432/linhoking

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS — comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# MT5 bridge — each user gets an API key instead of a JWT login,
# since the MQL5 Expert Advisor can't do an interactive OAuth flow.
# Generated per-user at /auth/mt5-key (see routers/mt5.py)
