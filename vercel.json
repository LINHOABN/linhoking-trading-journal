{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build && cd .. && python bundle_assets.py",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/assets/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/auth",
            "destination": "/api/main.py"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/trades",
            "destination": "/api/main.py"
        },
        {
            "source": "/trades/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/tiers",
            "destination": "/api/main.py"
        },
        {
            "source": "/tiers/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/stats",
            "destination": "/api/main.py"
        },
        {
            "source": "/stats/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/risk",
            "destination": "/api/main.py"
        },
        {
            "source": "/risk/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/deposits",
            "destination": "/api/main.py"
        },
        {
            "source": "/deposits/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/mt5",
            "destination": "/api/main.py"
        },
        {
            "source": "/mt5/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/health",
            "destination": "/api/main.py"
        }
    ]
}