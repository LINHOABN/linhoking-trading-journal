{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build && mkdir -p ../public && cp -r dist/* ../public/",
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/trades/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/tiers/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/stats/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/risk/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/deposits/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/mt5/:path*",
            "destination": "/api/main.py"
        },
        {
            "source": "/health",
            "destination": "/api/main.py"
        },
        {
            "source": "/((?!api|auth|trades|tiers|stats|risk|deposits|mt5|health|assets|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}