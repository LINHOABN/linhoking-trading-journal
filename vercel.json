{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/trades/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/tiers/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/stats/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/risk/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/deposits/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/mt5/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/health",
            "destination": "/api/index.py"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ]
}